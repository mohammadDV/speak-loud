parameters:
	ignoreErrors:
		-
			message: '#^Cannot access property \$id on Illuminate\\Database\\Eloquent\\Model\|int\|string\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Filament/Admin/Resources/Tickets/Pages/EditTicket.php

		-
			message: '#^Cannot access property \$resolved_at on Illuminate\\Database\\Eloquent\\Model\|int\|string\.$#'
			identifier: property.nonObject
			count: 1
			path: app/Filament/Admin/Resources/Tickets/Pages/EditTicket.php

		-
			message: '#^Parameter \#1 \$rules of method Filament\\Pages\\BasePage\:\:validate\(\) expects array\<string, array\<mixed\>\>\|null, array\<string, string\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Filament/Admin/Resources/Tickets/Pages/EditTicket.php

		-
			message: '#^Parameter \#1 \$ticket of method App\\Actions\\ReplyToTicket\:\:execute\(\) expects App\\Models\\Ticket, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: app/Filament/Admin/Resources/Tickets/Pages/EditTicket.php

		-
			message: '#^Match arm comparison between ''closed'' and ''closed'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 2
			path: app/Models/Ticket.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$day_of_week\.$#'
			identifier: property.notFound
			count: 1
			path: app/Support/UtcTime.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$end_datetime\.$#'
			identifier: property.notFound
			count: 2
			path: app/Support/UtcTime.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$end_time\.$#'
			identifier: property.notFound
			count: 1
			path: app/Support/UtcTime.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$start_datetime\.$#'
			identifier: property.notFound
			count: 2
			path: app/Support/UtcTime.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$start_time\.$#'
			identifier: property.notFound
